// A parameter is a local copy: inlining a body that assigns it must not write
// through to the caller's argument.

fn bump(x: i64) -> i64 {
    x = x + 1;
    return x;
}

fn clamp(x: i64) -> i64 {
    if x > 10 {
        x = 10;
    }
    return x;
}

fn main() -> i64 {
    let a: i64 = 5;
    print_i64(bump(a));
    print_i64(a);

    let b: i64 = 20;
    print_i64(clamp(b));
    print_i64(b);
    return 0;
}
