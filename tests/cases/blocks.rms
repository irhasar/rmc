// A bare `{ ... }` block is an expression statement and needs no `;`. Nested
// blocks, sibling blocks, and a block followed by another statement must parse,
// and an inner block's binding must not leak into the outer scope.
fn main() -> i64 {
    let x: i64 = 1;
    {
        let x: i64 = 2;
        {
            let x: i64 = 3;
            print_i64(x);
        }
        print_i64(x);
    }
    print_i64(x);
    {
        let y: i64 = 40;
        print_i64(y);
    }
    print_i64(50);
    return 0;
}
