// String literal patterns in `match` and `if let`. The test is a content
// compare, so a `match` on a `let`-bound string (a pointer to its record)
// matches by bytes; a pointer compare would fall through to `_` every time.
fn main() -> i64 {
    // A value-position match, with a catch-all.
    let s = "a";
    print_i64(match s { "a" => 1, "b" => 2, _ => 3 });
    print_i64(match s { "b" => 1, _ => 2 });
    // Several distinct literals, hit in the middle.
    let t = "b";
    print_i64(match t { "a" => 1, "b" => 2, _ => 3 });
    print_i64(match t { "a" => 1, "b" => 2, "c" => 3, _ => 4 });
    // An or-pattern over literals, sharing one body.
    print_i64(match t { "a" | "b" => 1, _ => 2 });
    print_i64(match t { "x" | "y" => 1, _ => 2 });
    // An empty literal is a valid pattern.
    let e = "";
    print_i64(match e { "" => 1, _ => 2 });
    print_i64(match e { "a" => 1, _ => 2 });
    // A prefix relationship, where a pointer compare and a content compare
    // could not both be right.
    let p = "abc";
    print_i64(match p { "ab" => 1, "abc" => 2, _ => 3 });
    // Statement position, unit arms.
    match s { "a" => print_str("A"), _ => print_str("other") };
    match s { "b" => print_str("B"), _ => print_str("not b") };
    // `if let`, both matched and not, with and without an `else`.
    if let "a" = s { print_i64(10); } else { print_i64(20); }
    if let "b" = s { print_i64(30); } else { print_i64(40); }
    if let "a" = s { print_i64(50); }
    // A match whose scrutinee is a literal directly.
    print_i64(match "hi" { "hi" => 1, _ => 2 });
    print_i64(match "ho" { "hi" => 1, _ => 2 });
    return 0;
}
