// References to places that are not a plain local: a struct field, a nested
// field, an array element and a nested array element, each read and written
// both directly and through a callee. A reference is one word holding an
// address, so a wrong address writes a neighbouring word; the reads after the
// writes pin the exact location. `references.rms` and `mut_refs.rms` cover
// references to a scalar, a struct and an array as a whole, but not a
// sub-place of an aggregate.
struct Inner { a: i64, b: i64 }
struct Outer { s: i64, mid: Inner, arr: [i64; 3] }

fn inc(r: &mut i64) { *r = *r + 1; }
fn addto(r: &mut i64, v: i64) { *r = *r + v; }
fn sumfields(r: &Outer) -> i64 { return r.s + r.mid.a + r.mid.b + r.arr[0]; }
fn setmid(r: &mut Outer, v: i64) { r.mid.a = r.mid.a + v; }

fn main() -> i64 {
    // A reference to a scalar place.
    let mut x: i64 = 10;
    inc(&mut x);
    addto(&mut x, 5);
    print_i64(x);

    // A reference to a struct field and to a nested field.
    let mut o: Outer = Outer { s: 1, mid: Inner { a: 2, b: 3 }, arr: [4, 5, 6] };
    inc(&mut o.s);
    inc(&mut o.mid.a);
    addto(&mut o.mid.b, 10);
    print_i64(o.s + o.mid.a + o.mid.b);
    print_i64(sumfields(&o));
    setmid(&mut o, 7);
    print_i64(o.mid.a);

    // A reference to an array element.
    let mut a: [i64; 3] = [1, 2, 3];
    inc(&mut a[0]);
    addto(&mut a[2], 10);
    print_i64(a[0] + a[1] + a[2]);

    // A reference to a nested array element: the address must stride by the
    // element size, not one word.
    let mut m: [[i64; 2]; 2] = [[1, 2], [3, 4]];
    inc(&mut m[1][1]);
    inc(&mut m[0][0]);
    print_i64(m[0][0] + m[0][1] + m[1][0] + m[1][1]);

    // A whole aggregate read through a reference.
    let o2: Outer = Outer { s: 5, mid: Inner { a: 6, b: 7 }, arr: [8, 9, 10] };
    print_i64(sumfields(&o2));

    // A reference local that is the destination of an update.
    let mut acc: i64 = 100;
    let rl: &mut i64 = &mut acc;
    *rl = *rl + 1;
    print_i64(acc);
    return 0;
}
