// Range patterns `lo..hi` (half-open) and `lo..=hi` (inclusive) in a `match`
// arm and in `if let`, over i64. A range desugars to `lo <= s && s < hi`, so it
// reuses the ordinary comparison code; it is not exhaustive by itself, so a
// `_` arm is still needed. An empty range (`5..5`, `6..5`) is a compile error.
fn bucket(x: i64) -> i64 {
    return match x {
        0 => 0,
        1..=5 => 1,
        6..10 => 2,
        -5..0 => 3,
        _ => 4,
    };
}

fn main() -> i64 {
    print_i64(bucket(0));
    print_i64(bucket(3));
    print_i64(bucket(5));
    print_i64(bucket(6));
    print_i64(bucket(9));
    print_i64(bucket(10));
    print_i64(bucket(-3));
    print_i64(bucket(-5));
    print_i64(bucket(100));

    // A range arm and an or-pattern arm in the same match.
    let x: i64 = 100;
    print_i64(match x { 1..=5 => 1, 90 | 100 => 2, _ => 0 });

    // Range in `if let`.
    let y: i64 = 4;
    if let 1..=5 = y {
        print_i64(1);
    } else {
        print_i64(0);
    }

    // The full i64 domain, written with both bounds.
    let z: i64 = 42;
    match z {
        -9223372036854775808..=9223372036854775807 => {
            print_i64(7);
        }
        _ => {
            print_i64(0);
        }
    }

    return 0;
}
