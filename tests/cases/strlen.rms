// `str::len` and array `.len()`. A `str` value is a pointer to a `{len, bytes}`
// record, so `s.len()` must read the record's length word, not a struct field of
// the pointer; an array's length is known at compile time, so `a.len()` is a
// constant. rustc has both, so every line must agree.
fn main() -> i64 {
    // A literal, an empty literal, and a let-bound string.
    print_i64("hello".len());
    print_i64("".len());
    print_i64("a".len());
    let s = "hello, world";
    print_i64(s.len());
    // A length used in arithmetic and as a bound.
    let t = "abcd";
    print_i64(t.len() + 1);
    print_i64(t.len() * 2);
    let mut i = 0;
    let mut sum = 0;
    while i < t.len() {
        sum = sum + i;
        i = i + 1;
    }
    print_i64(sum);
    // Array lengths, including one derived from a repeat and one bound to a
    // `let`; both are constants.
    let a = [10, 20, 30];
    print_i64(a.len());
    let b = [7; 5];
    print_i64(b.len());
    print_i64(a.len() + b.len());
    // A `str` in a variable used as a `while` bound.
    let mut k = 0;
    while k < s.len() {
        k = k + 1;
    }
    print_i64(k);
    // `len()` on a string literal directly, in a condition.
    if "abc".len() == 3 { print_i64(1); } else { print_i64(0); }
    return 0;
}
