struct Point { x: i64, y: i64 }

fn dist2(a: i64, b: i64) -> i64 {
    return a * a + b * b;
}

fn main() -> i64 {
    let mut p: Point = Point { x: 3, y: 4 };
    print_i64(p.x);
    print_i64(p.y);
    print_i64(dist2(p.x, p.y));
    p.x = p.x + 100;
    p.y = -p.y;
    print_i64(p.x);
    print_i64(p.y);
    let q: Point = Point { y: 7, x: -2 };
    print_i64(q.x + q.y);
    let r: Point = Point { x: 1, y: 1 };
    print_i64(r.x * r.y);
    return 0;
}
