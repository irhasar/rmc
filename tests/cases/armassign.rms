// A `match` arm body may be a bare assignment or compound assignment
// (`0 => acc = acc + 1`, `1 => acc += 10`) or a `return`/`break`, not just an
// expression. rmc parses those only as statements, so the arm body parser
// accepts them explicitly.
fn classify(x: i64) -> i64 {
    match x {
        0 => return 100,
        _ => return x * 2,
    }
}

fn main() -> i64 {
    let mut acc: i64 = 0;
    let mut x: i64 = 0;
    while x < 12 {
        match x {
            0 => acc = acc + 1,
            1 | 2 => acc += 10,
            3..=5 => acc -= 1,
            _ => {}
        }
        if let 6 | 7 = x { acc = acc + 100; }
        x += 1;
    }
    print_i64(acc);

    let mut i: i64 = 0;
    let mut s: i64 = 0;
    while i < 10 {
        match i {
            4 => break,
            _ => s = s + i,
        }
        i = i + 1;
    }
    print_i64(s + classify(3));

    let mut y: i64 = 0;
    while let 0..=4 = y {
        y = y + 1;
    }
    print_i64(y);
    return 0;
}
