// Many live locals with a call inside a loop: exercises promoting locals into
// callee-saved registers while the frame and the saved registers coexist.
fn helper(a: i64, b: i64) -> i64 {
    return a * 3 + b;
}

fn work(n: i64) -> i64 {
    let mut a: i64 = 1;
    let mut b: i64 = 2;
    let mut c: i64 = 3;
    let mut d: i64 = 4;
    let mut e: i64 = 5;
    let mut f: i64 = 6;
    let mut g: i64 = 7;
    let mut i: i64 = 0;
    while i < n {
        a = a + helper(b, c);
        b = b + helper(c, d);
        c = c + helper(d, e);
        d = d + helper(e, f);
        e = e + helper(f, g);
        f = f + helper(g, a);
        g = g + helper(a, b);
        i = i + 1;
    }
    return a + b + c + d + e + f + g;
}

fn main() -> i64 {
    print_i64(work(5));
    print_i64(work(10));
    print_i64(work(100));
    return 0;
}
