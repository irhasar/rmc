// `let _ = e;` discards `e`: it is evaluated once for its side effects and
// binds nothing. rmc used to reject it with "expected identifier, found `_`".
// The variants below are the ones rustc accepts (`let _: T;` with no
// initialiser is a no-op; `let _;` with no annotation is rustc E0282).
fn side(n: i64) -> i64 { print_i64(n); return n + 1; }

struct P { x: i64 }

fn main() -> i64 {
    // A plain discard of a value and of a call, whose side effect must run once.
    let _ = 3 + 4;
    let _ = side(10);
    let _ = side(20) + side(30);

    // Annotated discard, with and without an initialiser.
    let _: i64 = side(40);
    let _: i64;
    let _: bool = true;

    // Discarding aggregate and control-flow expressions.
    let _ = [1, 2, 3];
    let _ = P { x: 7 };
    let _ = if true { side(50) } else { side(60) };

    // The discarded binding leaves no name behind: the outer `x` is untouched.
    let x: i64 = 5;
    let _ = x;
    print_i64(x);

    // Discard inside a loop body.
    let mut i: i64 = 0;
    while i < 2 {
        let _ = side(70);
        i = i + 1;
    }
    return 0;
}
