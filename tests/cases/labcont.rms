fn main() -> i64 {
    let mut x: i64 = 0;
    let mut i: i64 = 0;
    'outer: loop {
        i = i + 1;
        if i > 5 { break; }
        let mut j: i64 = 0;
        loop {
            j = j + 1;
            x = x + 1;
            if j >= 2 { continue 'outer; }
        }
    }
    print_i64(x);
    return 0;
}
