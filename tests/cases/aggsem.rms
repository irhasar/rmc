// By-value aggregate semantics: whole-array/struct assignment copies contents,
// inferred aggregates keep their initialization, nested struct fields copy, and
// an array returned from a call can be indexed.
struct Inner { x: i64, y: i64 }
struct Outer { inner: Inner, z: i64 }

fn make3(x: i64) -> [i64; 3] { return [x, x + 1, x + 2]; }

fn main() -> i64 {
    let mut a: [i64; 2] = [0; 2];
    let b: [i64; 2] = [3; 2];
    a = b;
    print_i64(a[0]);
    print_i64(a[1]);

    let c = [7; 2];
    print_i64(c[0]);
    print_i64(c[1]);

    let o: Outer = Outer { inner: Inner { x: 1, y: 2 }, z: 3 };
    print_i64(o.inner.x);
    print_i64(o.inner.y);
    print_i64(o.z);

    print_i64(make3(10)[0]);
    print_i64(make3(10)[2]);

    let mut p: Inner = Inner { x: 5, y: 6 };
    let q: Inner = Inner { x: 7, y: 8 };
    p = q;
    print_i64(p.x);
    print_i64(p.y);
    return 0;
}
