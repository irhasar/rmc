// Reading a field or element of an aggregate *temporary*: a call's return
// value, a block, an `if`, or a struct literal. Each is a value that is its own
// address, so codegen must evaluate the base rather than look for an lvalue.
// Accessing `mk().y` used to hit an `unreachable!()` and abort the compiler.
struct P { x: i64, y: i64 }
struct A { v: i64 }
struct B { a: A }
struct Q { a: [i64; 3] }

fn mk(a: i64) -> P { return P { x: a, y: a * 2 }; }
fn mk_b() -> B { return B { a: A { v: 77 } }; }
fn mk_q() -> Q { return Q { a: [10, 20, 30] }; }

fn main() -> i64 {
    print_i64(mk(5).y);
    print_i64(mk(5).x);
    print_i64(mk_b().a.v);
    print_i64(mk_q().a[1]);
    print_i64((P { x: 1, y: 2 }).y);
    print_i64({ P { x: 3, y: 4 } }.y);
    print_i64((if true { P { x: 5, y: 6 } } else { P { x: 7, y: 8 } }).y);
    print_i64((Q { a: [4, 5, 6] }).a[2]);
    return 0;
}
