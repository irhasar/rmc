// Every `{}` argument is evaluated before the first byte of output, in source
// order, matching Rust. The `println!` lowering interleaves literal chunks with
// `{}` writes, so `f`/`g` must run before "A" is printed, not between "A" and
// `f`'s value. The markers use `println!` on both sides of the twin, so the
// stdout comparison rests on the format-order rule alone and not on the raw
// `print_str` newline convention.
fn f() -> str {
    println!("1");
    return "ten";
}

fn g() -> str {
    println!("2");
    return "twenty";
}

fn main() -> i64 {
    println!("A{}B{}", f(), g());
    return 0;
}
