// Out-of-range shift counts. Rust's `<<`/`>>` panic when the count is outside
// 0..=63 even without overflow checks, because the hardware would otherwise mask
// the count to 6 bits and shift by `count & 63`. The count is a runtime argument
// so the check is exercised at run time rather than constant-folded away; `<<`
// `>>` and the compound `<<=` all take the same path.
fn main() -> i64 {
    let n: i64 = arg_i64(1);
    let mut y: i64 = 1;
    print_i64(y << n);
    print_i64(y >> n);
    y <<= n;
    print_i64(y);
    return 0;
}
