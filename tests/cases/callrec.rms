// A call-heavy non-tail recursion. `1 + tree(n - 1) + tree(n - 2)` parses as
// `(1 + tree(n - 1)) + tree(n - 2)`, so the left operand of the top `+` is not a
// self-call. The right spine still folds into a loop, giving one call per level;
// this case exists so the differential suite covers that shape (values are
// checked against rustc, which does the same transform).
fn tree(n: i64) -> i64 {
    if n <= 1 {
        return n;
    }
    return 1 + tree(n - 1) + tree(n - 2);
}

fn main() -> i64 {
    print_i64(tree(arg_i64(1)));
    return 0;
}
