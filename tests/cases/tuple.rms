// Tuples: construction, field access, destructuring, nesting, and use as
// parameters and return values. A tuple is an aggregate laid out like a struct
// with fields "0", "1", ....

fn swap(p: (i64, i64)) -> (i64, i64) {
    return (p.1, p.0);
}

fn add(p: (i64, i64)) -> i64 {
    return p.0 + p.1;
}

fn sum3(t: (i64, i64, i64)) -> i64 {
    return t.0 + t.1 + t.2;
}

fn diff((a, b): (i64, i64)) -> i64 {
    return a - b;
}

fn main() -> i64 {
    let t = (1, 2);
    print_i64(t.0);
    print_i64(t.1);

    let s = swap(t);
    print_i64(s.0);
    print_i64(s.1);
    print_i64(add(s));

    // Destructuring, including a `mut` element.
    let (a, mut b) = s;
    b = b + 10;
    print_i64(a);
    print_i64(b);

    // A tuple mixing element types, with an annotation.
    let u: (i64, bool) = (7, true);
    if u.1 {
        print_i64(u.0);
    }

    // Nested tuples: `nested.0` is itself a tuple.
    let nested = ((1, 2), 3);
    print_i64(nested.0.0);
    print_i64(nested.0.1);
    print_i64(nested.1);

    // A three-element tuple through a call.
    print_i64(sum3((10, 20, 30)));

    // A tuple parameter pattern.
    print_i64(diff((9, 4)));

    // A tuple pattern in a `for` head over an array of tuples.
    let pairs: [(i64, i64); 2] = [(1, 2), (3, 4)];
    let mut total = 0;
    for (x, y) in pairs {
        total = total + x * 10 + y;
    }
    print_i64(total);

    // A tuple pattern in a `match` arm.
    match (7, 8) {
        (x, y) => {
            print_i64(x * 100 + y);
        }
    }

    // `_` ignores an element.
    let (only, _) = (99, 0);
    print_i64(only);

    // A tuple stored in a struct field, then read back.
    print_i64(add((4, 5)));

    return 0;
}
