// Tuples: construction, field access, destructuring, nesting, and use as
// parameters and return values. A tuple is an aggregate laid out like a struct
// with fields "0", "1", ....

fn swap(p: (i64, i64)) -> (i64, i64) {
    return (p.1, p.0);
}

fn add(p: (i64, i64)) -> i64 {
    return p.0 + p.1;
}

fn sum3(t: (i64, i64, i64)) -> i64 {
    return t.0 + t.1 + t.2;
}

fn diff((a, b): (i64, i64)) -> i64 {
    return a - b;
}

fn main() -> i64 {
    let t = (1, 2);
    print_i64(t.0);
    print_i64(t.1);

    let s = swap(t);
    print_i64(s.0);
    print_i64(s.1);
    print_i64(add(s));

    // Destructuring, including a `mut` element.
    let (a, mut b) = s;
    b = b + 10;
    print_i64(a);
    print_i64(b);

    // A tuple mixing element types, with an annotation.
    let u: (i64, bool) = (7, true);
    if u.1 {
        print_i64(u.0);
    }

    // Nested tuples: `nested.0` is itself a tuple.
    let nested = ((1, 2), 3);
    print_i64(nested.0.0);
    print_i64(nested.0.1);
    print_i64(nested.1);

    // A three-element tuple through a call.
    print_i64(sum3((10, 20, 30)));

    // A tuple parameter pattern.
    print_i64(diff((9, 4)));

    // A tuple pattern in a `for` head over an array of tuples.
    let pairs: [(i64, i64); 2] = [(1, 2), (3, 4)];
    let mut total = 0;
    for (x, y) in pairs {
        total = total + x * 10 + y;
    }
    print_i64(total);

    // A tuple pattern in a `match` arm.
    match (7, 8) {
        (x, y) => {
            print_i64(x * 100 + y);
        }
    }

    // `_` ignores an element.
    let (only, _) = (99, 0);
    print_i64(only);

    // A tuple stored in a struct field, then read back.
    print_i64(add((4, 5)));

    // A refutable tuple pattern: a literal element test, then a catch-all.
    match (3, 4) {
        (0, _) => {
            print_i64(-1);
        }
        (a, b) => {
            print_i64(a * 10 + b);
        }
    }

    // A bool element test and a range element test.
    match (true, 6) {
        (true, 0..=9) => {
            print_i64(1);
        }
        _ => {
            print_i64(0);
        }
    }

    // An or-pattern element: any alternative matching passes.
    match (2, 5) {
        (0 | 1 | 2, x) => {
            print_i64(x);
        }
        _ => {
            print_i64(-1);
        }
    }

    // `if let` with a refutable tuple, hit and missed.
    if let (7, x) = (7, 8) {
        print_i64(x);
    }
    if let (7, x) = (9, 8) {
        print_i64(x);
    } else {
        print_i64(100);
    }

    // A nested refutable tuple element.
    match (1, (0, 3)) {
        (a, (0, c)) => {
            print_i64(a + c);
        }
        _ => {
            print_i64(-1);
        }
    }

    // `while let` re-tests a refutable tuple each iteration.
    let mut k = 0;
    let mut acc = 0;
    while let (0, x) = (0, k) {
        acc = acc + x;
        k = k + 1;
        if k >= 4 {
            break;
        }
    }
    print_i64(acc);

    return 0;
}
