// Top-level `const` items. rmc folds each to a single value and substitutes it
// at every use, so a constant has no storage and no codegen. Exercised here in
// expression position, as an array length and repeat count, as a `for` bound, in
// a condition, and as a `match` pattern — including an `i64` constant declared
// in terms of another and a negative one.
const N: i64 = 5;
const M: i64 = N * 2;
const LIMIT: i64 = M + 1;
const BIG: bool = LIMIT > 10;
const YES: bool = true;
const NEG: i64 = 0 - 3;

fn main() -> i64 {
    // A constant in expression position.
    print_i64(N);
    print_i64(M);
    print_i64(LIMIT);
    print_i64(NEG);

    // A constant as an array length, and as an array repeat count.
    let a: [i64; N] = [1, 2, 3, 4, 5];
    let b: [i64; N] = [7; N];
    print_i64(a[0] + a[N - 1]);
    print_i64(b[4]);

    // A constant used in a `for` bound.
    let mut s: i64 = 0;
    for i in 0..N {
        s = s + a[i];
    }
    print_i64(s);

    // A constant in a condition and in a `match` pattern.
    if BIG { print_i64(100); }
    if YES { print_i64(200); }
    match N {
        N => { print_i64(300); }
        _ => { print_i64(301); }
    }
    match NEG {
        NEG => { print_i64(400); }
        _ => { print_i64(401); }
    }
    // A constant in a value-position `if`.
    let v: i64 = if BIG { M } else { 0 };
    print_i64(v);
    return 0;
}
