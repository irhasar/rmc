// Every comparison operator, with the immediate on either side. This is the
// shape that hid an inverted-operand bug, so both orders are exercised.
fn main() -> i64 {
    let mut x: i64 = 10;
    print_bool(5 < x);
    print_bool(x < 5);
    print_bool(5 > x);
    print_bool(x > 5);
    print_bool(10 <= x);
    print_bool(11 <= x);
    print_bool(x <= 10);
    print_bool(x <= 9);
    print_bool(10 >= x);
    print_bool(9 >= x);
    print_bool(x >= 10);
    print_bool(x >= 11);
    print_bool(10 == x);
    print_bool(11 == x);
    print_bool(10 != x);
    print_bool(11 != x);
    let mut y: i64 = 3;
    print_bool(2 < y);
    print_bool(2 > y);
    print_bool(3 < y);
    print_bool(3 > y);
    print_bool(0 <= y);
    print_bool(0 >= y);
    print_bool(y < y);
    print_bool(y <= y);
    print_bool(y >= y);
    print_bool(y == y);
    print_bool(y != y);
    return 0;
}
