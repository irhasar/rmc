// The rmc twin of `printfmt.rs`: the same output written with the raw output
// builtins, so a divergence in the `print!`/`println!` lowering shows up as a
// stdout mismatch. `bool` is written as the words `true`/`false` because that
// is what rustc's `{}` prints, while `print_bool` prints `0`/`1`.
fn main() -> i64 {
    print_str("hello");
    print_i64(42);
    print_i64(-7);
    print_str("true");
    print_str("false");
    print_str("text");
    print_str("braces {}");
    print_str("x=1 y=2");
    print_str("9 and -8");
    // "no newline", then the newline `println!()` adds.
    putchar(110); putchar(111); putchar(32); putchar(110); putchar(101); putchar(119); putchar(108); putchar(105); putchar(110); putchar(101); putchar(10);
    return 0;
}
