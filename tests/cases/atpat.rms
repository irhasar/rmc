// `@` bindings (`name @ subpat`): the whole value bound alongside a
// sub-pattern, in `let`, `for`, `match`, `if let`, struct fields and
// parameters.

struct P {
    x: i64,
    y: i64,
    z: i64,
}

fn takes(n @ _: i64, mut m @ _: i64) -> i64 {
    m = m + n;
    return m;
}

fn pair(t @ (a, b): (i64, i64)) -> i64 {
    return t.0 + t.1 + a + b;
}

fn main() -> i64 {
    // A plain alias and a chain of aliases.
    let x = 10;
    let n @ _ = x;
    let p @ q @ _ = x;
    print_i64(n + p + q);

    // A tuple sub-pattern: the whole tuple and each element bound.
    let t @ (a, c) = (3, 4);
    print_i64(t.0 + t.1 + a + c);

    // A struct field sub-pattern, with a `mut` alias that is written.
    let s = P { x: 1, y: 2, z: 3 };
    let P { x: r @ _, y: mut w @ _, .. } = s;
    w = w + 1;
    print_i64(r + w);

    // `for` over a range: a plain alias and a second binding.
    let mut acc = 0;
    for i @ _ in 0..4 {
        acc = acc + i;
    }
    print_i64(acc);
    for i @ j in 0..3 {
        acc = acc + i + j;
    }
    print_i64(acc);

    // `for` over an array.
    let arr = [5, 6, 7];
    for e @ _ in arr {
        acc = acc + e;
    }
    print_i64(acc);

    // A `mut` alias inside an array and a tuple element.
    let two = [5, 6];
    let [mut d @ _, h] = two;
    d = d + 1;
    print_i64(d + h);
    let (mut u @ _, v) = (1, 2);
    u = u + 1;
    print_i64(u + v);

    // A refutable `@` in a `match` arm and an `if let`.
    match x {
        k @ 1..=100 => {
            print_i64(k);
        }
        _ => {}
    }
    if let k @ 1..=100 = x {
        print_i64(k + 1);
    }

    // Parameters, including a `mut` alias and a tuple sub-pattern.
    print_i64(takes(x, x + 1));
    print_i64(pair((x, x + 2)));
    return 0;
}
