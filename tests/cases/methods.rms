struct Point { x: i64, y: i64 }
struct Counter { n: i64 }

impl Point {
    fn sum(self) -> i64 { return self.x + self.y; }
    fn moved(self, dx: i64, dy: i64) -> Point {
        return Point { x: self.x + dx, y: self.y + dy };
    }
    fn same(self, o: Point) -> bool { return self.x == o.x && self.y == o.y; }
    fn scale(self, k: i64) -> Self { return Self { x: self.x * k, y: self.y * k }; }
    fn norm1(self) -> i64 { if self.x < 0 { return 0 - self.x + self.y; } return self.x + self.y; }
}

impl Counter {
    fn factorial(self) -> i64 {
        let mut r: i64 = 1;
        let mut i: i64 = 1;
        while i <= self.n { r = r * i; i = i + 1; }
        return r;
    }
    fn is_big(self) -> bool { return self.n > 3; }
}

fn main() -> i64 {
    let p: Point = Point { x: 3, y: 4 };
    print_i64(p.sum());
    let q: Point = p.moved(1, 2);
    print_i64(q.sum());
    print_bool(p.same(Point { x: 3, y: 4 }));
    print_bool(p.same(q));
    let s: Point = p.scale(2);
    print_i64(s.x);
    print_i64(s.y);
    // chained calls
    print_i64(p.scale(2).scale(3).sum());
    // method on a struct literal directly
    print_i64(Point { x: 10, y: 20 }.sum());
    let c: Counter = Counter { n: 5 };
    print_i64(c.factorial());
    print_bool(c.is_big());
    print_i64(Point { x: 0 - 5, y: 2 }.norm1());
    return 0;
}
