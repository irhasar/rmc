// Reference-to-reference field access, and a store whose value has set high
// bits, both of which exercise addressing paths that once read the wrong word.
struct S { x: i64, y: i64 }

fn main() -> i64 {
    let mut s: S = S { x: 42, y: 7 };
    let p: &S = &s;
    let q: &&S = &p;
    print_i64((*q).y);
    print_i64((*q).x);

    let mut a: i64 = 4294967296;
    let r: &mut i64 = &mut a;
    *r = 42;
    print_i64(a);

    let mut b: S = S { x: 1, y: 2 };
    let pb: &mut S = &mut b;
    let qb: &mut &mut S = &mut pb;
    (*qb).x = 9;
    (*qb).y = 8;
    print_i64(b.x);
    print_i64(b.y);
    return 0;
}
