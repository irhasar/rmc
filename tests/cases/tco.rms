fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fact(n: i64) -> i64 {
    if n < 2 {
        return 1;
    }
    return fact(n - 1) * n;
}

fn main() -> i64 {
    let n: i64 = arg_i64(1);
    print_i64(fib(n));
    print_i64(fact(n));
    return 0;
}
