fn count(t: [bool; 5]) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < 5 {
        if t[i] { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn main() -> i64 {
    // list literal, list literal passed straight to a call
    let a: [bool; 5] = [true, false, true, true, false];
    print_i64(count(a));
    print_i64(count([c_or(a[0]), a[1], true, false, true]));
    // repeat literal, then mutate an element
    let mut b: [bool; 3] = [false; 3];
    b[1] = true;
    print_bool(b[0]);
    print_bool(b[1]);
    print_bool(b[2]);
    // inferred element type from a list literal
    let d = [a[0], b[1]];
    print_bool(d[0]);
    print_bool(d[1]);
    return 0;
}

fn c_or(x: bool) -> bool { return x; }
