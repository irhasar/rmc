// Payload variant patterns: a variant's arguments may be a wildcard (`_`), a
// mutable binding (`mut x`), a trailing `..` that ignores the remaining fields,
// or a nested struct/array sub-pattern, not just a flat list of names. Each
// argument is the payload read at its field index, fed to the same sub-pattern
// expansion a `let` destructuring uses, so the nesting directions compose.
struct I { u: i64 }
struct S { a: [i64; 2], b: I }

enum E {
    Pair(i64, i64),
    Trip(i64, i64, i64),
    Hold(S),
    Arr([i64; 2]),
    Mix(i64, S, [i64; 2]),
    None,
}

fn wildcard(e: E) -> i64 {
    match e {
        E::Pair(_, y) => return y,
        _ => return 0,
    }
}

fn mutate(e: E) -> i64 {
    match e {
        E::Pair(mut x, y) => { x = x + y; return x; }
        _ => return 0,
    }
}

fn rest_prefix(e: E) -> i64 {
    match e {
        E::Trip(x, ..) => return x,
        _ => return 0,
    }
}

fn rest_only(e: E) -> i64 {
    match e {
        E::Trip(..) => return 1,
        E::None => return 0,
        _ => return 0 - 1,
    }
}

fn nested_struct(e: E) -> i64 {
    match e {
        E::Hold(S { a: [p, q], b: I { u } }) => return p * 100 + q * 10 + u,
        _ => return 0,
    }
}

fn nested_array(e: E) -> i64 {
    match e {
        E::Arr([a, b]) => return a * 10 + b,
        _ => return 0,
    }
}

fn mixed(e: E) -> i64 {
    match e {
        E::Mix(n, S { a: [p, q], b: I { u } }, [r, s]) => return n + p + q + u + r + s,
        _ => return 0,
    }
}

impl E {
    fn first(self) -> i64 {
        match self {
            E::Pair(x, ..) => return x,
            E::Trip(x, ..) => return x,
            _ => return 0,
        }
    }
}

// A pattern reads through a reference to the scrutinee, as match ergonomics
// does: `&e` is dereferenced to the `E` underneath, so the test and every
// payload read go through the one deref.
fn via_ref(e: &E) -> i64 {
    match e {
        E::Pair(x, _) => return x * 2,
        E::Trip(x, ..) => return x * 3,
        _ => return 0,
    }
}

fn unit_via_ref(e: &E) -> i64 {
    match e {
        E::None => return 100,
        E::Pair(_, _) => return 200,
        E::Trip(_, _, _) => return 300,
        E::Hold(_) => return 400,
        E::Arr(_) => return 500,
        E::Mix(_, _, _) => return 600,
    }
}

fn nested_via_ref(e: &E) -> i64 {
    match e {
        E::Hold(S { a: [p, q], b: I { u } }) => return p * 100 + q * 10 + u,
        _ => return 0,
    }
}

fn main() -> i64 {
    print_i64(wildcard(E::Pair(3, 4)));
    print_i64(mutate(E::Pair(3, 4)));
    print_i64(rest_prefix(E::Trip(5, 6, 7)));
    print_i64(rest_only(E::Trip(1, 2, 3)));
    print_i64(rest_only(E::None));
    print_i64(nested_struct(E::Hold(S { a: [1, 2], b: I { u: 3 } })));
    print_i64(nested_array(E::Arr([7, 8])));
    print_i64(mixed(E::Mix(1, S { a: [2, 3], b: I { u: 4 } }, [5, 6])));
    print_i64(E::Pair(9, 10).first());
    print_i64(E::Trip(11, 12, 13).first());

    // `if let` with a nested payload pattern.
    let e: E = E::Hold(S { a: [4, 5], b: I { u: 6 } });
    if let E::Hold(S { a: [p, q], b: I { u } }) = e {
        print_i64(p + q + u);
    }

    // Patterns through a reference to the scrutinee.
    print_i64(via_ref(&E::Pair(7, 8)));
    print_i64(via_ref(&E::Trip(9, 10, 11)));
    print_i64(via_ref(&E::None));
    print_i64(unit_via_ref(&E::None));
    print_i64(unit_via_ref(&E::Arr([1, 2])));
    print_i64(nested_via_ref(&E::Hold(S { a: [1, 2], b: I { u: 3 } })));

    // `if let` through a reference.
    let f: E = E::Pair(21, 22);
    if let E::Pair(x, y) = &f {
        print_i64(x * 100 + y);
    }

    return 0;
}
