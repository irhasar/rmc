// A linked list built on the heap: `alloc` a node, cast the returned address
// to `&mut Node` to write its fields, then chase the `next` links back. This
// exercises the raw pointer cast (`i64 as &mut Node`) and writes/reads through
// a `&mut`/`&` reference in a loop. The Rust twin bumps through one arena, so
// the two do the same pointer arithmetic; only the printed sum must match.
struct Node { val: i64, next: i64 }

fn main() -> i64 {
    let n: i64 = 5000;
    let mut head: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let p: i64 = alloc(16);
        let np: &mut Node = p as &mut Node;
        (*np).val = i;
        (*np).next = head;
        head = p;
        i = i + 1;
    }
    let mut sum: i64 = 0;
    let mut cur: i64 = head;
    while cur != 0 {
        let cp: &Node = cur as &Node;
        sum = sum + (*cp).val;
        cur = (*cp).next;
    }
    print_i64(sum);
    return 0;
}
