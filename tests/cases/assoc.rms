// Associated functions: `fn name(..)` with no `self` in an `impl` is called
// through the type (`P::new(..)`), not on a value. It is a very common Rust
// idiom (the constructor pattern), and rustc accepts it; before this case rmc
// rejected it with "method `new` must take `self` as its first parameter".
//
// The same case covers `as` precedence: `as` binds looser than the unary
// operators, so `*r as i64` is `(*r) as i64`, not `*(r as i64)`.
struct Point { x: i64, y: i64 }

impl Point {
    // An associated function: no `self`, called as `Point::new(..)`.
    fn new(x: i64, y: i64) -> Point { return Point { x, y }; }
    fn origin() -> Point { return Point { x: 0, y: 0 }; }
    fn twice(n: i64) -> i64 { return n * 2; }

    // A method alongside an associated function on the same type.
    fn sum(&self) -> i64 { return self.x + self.y; }
    fn shifted(&self, d: i64) -> Point { return Point::new(self.x + d, self.y + d); }
}

enum Tag { Off, On }

impl Tag {
    fn from_flag(b: bool) -> Tag { if b { return Tag::On; } return Tag::Off; }
    fn is_on(self) -> bool { return (self as i64) == 1; }
}

enum Opt { None, Some(i64) }

impl Opt {
    fn wrap(v: i64) -> Opt { return Opt::Some(v); }
}

fn main() -> i64 {
    // Associated function returns an aggregate; method call chains off it.
    let p: Point = Point::new(3, 4);
    print_i64(p.sum());
    print_i64(Point::new(1, 2).sum());
    print_i64(Point::origin().sum());
    print_i64(Point::twice(21));
    // Associated function used inside a method body.
    print_i64(p.shifted(10).sum());

    // Enum associated functions, unit and payload.
    print_bool(Tag::from_flag(true).is_on());
    print_bool(Tag::from_flag(false).is_on());
    match Opt::wrap(9) {
        Opt::Some(v) => print_i64(v),
        Opt::None => print_i64(0),
    }

    // `as` precedence: all three parse as `(unary) as i64`.
    let x: i64 = 5;
    let r: &i64 = &x;
    print_i64(*r as i64);
    print_i64(-x as i64);
    let b: bool = true;
    print_i64(b as i64 * 2);
    return 0;
}
