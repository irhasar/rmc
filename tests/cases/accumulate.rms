fn main() -> i64 {
    let n: i64 = arg_i64(1);
    let xs: [i64; 4] = [3, 5, 7, 11];
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        acc = acc + xs[0] + xs[1] + xs[2] + xs[3];
        acc = acc + i + 2;
        acc = acc - i + xs[1] - 1;
        i = i + 1;
    }
    print_i64(acc);
    return 0;
}
