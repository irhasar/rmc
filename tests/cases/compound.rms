fn main() -> i64 {
    let mut x: i64 = 100;
    x += 5;
    print_i64(x);
    x -= 20;
    print_i64(x);
    x *= 3;
    print_i64(x);
    x /= 4;
    print_i64(x);
    x %= 7;
    print_i64(x);
    let mut arr: [i64; 3] = [1, 2, 3];
    arr[1] += 10;
    print_i64(arr[0] + arr[1] + arr[2]);
    return 0;
}
