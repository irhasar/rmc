// Indexing a reference to an array must use the *referent's* element type.
// Before the fix the element type defaulted to i64, so a bool element read
// through `&[bool; N]` produced a non-canonical value and `!` on it was wrong.
enum E { A, B }

fn main() {
    let a = [false, true, true, false];
    let r: &[bool; 4] = &a;
    let b: bool = !r[0];
    print_bool(b);
    print_bool(!r[1]);
    print_bool(!r[2]);
    print_bool(!r[3]);

    let e = [E::A, E::B];
    let er: &[E; 2] = &e;
    print_bool(er[0] as i64 == 0);
    print_bool(er[1] as i64 == 1);
}
