// Deeply nested expressions mixing calls, indexing and comparisons, plus
// variable shadowing. This is where operand folding tends to go wrong.
fn f(a: i64, b: i64) -> i64 {
    return a * b - a + b;
}
fn g(x: i64) -> i64 {
    if x <= 0 {
        return 0;
    }
    return x + g(x - 1);
}
fn main() -> i64 {
    let mut a: [i64; 6];
    let mut i: i64 = 0;
    while i < 6 {
        a[i] = i + 1;
        i = i + 1;
    }
    print_i64(f(a[0], a[1]) + f(a[2], a[3]) - f(a[4], a[5]));
    print_i64(g(10));
    print_i64((a[0] + a[1]) * (a[2] + a[3]) - (a[4] * a[5]));
    let x: i64 = 5;
    {
        let x: i64 = x + 100;
        print_i64(x);
        {
            let x: i64 = x * 2;
            print_i64(x);
        };
        print_i64(x);
    };
    print_i64(x);
    let mut c: i64 = 0;
    c = c + f(1, 2) + f(3, 4) + f(5, 6);
    print_i64(c);
    print_i64(if a[1] < a[2] { g(3) } else { g(4) });
    print_i64(f(f(1, 2), f(3, 4)));
    return 0;
}
