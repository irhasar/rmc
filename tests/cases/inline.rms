// Inlining must not change observable behaviour: side effects run the same
// number of times and in the same order whether a call is inlined or not.
struct P { x: i64, y: i64 }

impl P {
    fn sum(&self) -> i64 { return self.x + self.y; }
    fn bump(&mut self) -> i64 { self.x = self.x + 1; return self.x; }
}

fn side(v: i64) -> i64 { print_i64(v); return v * 2; }

fn double(v: i64) -> i64 { return v + v; }

fn wrap(p: &P) -> i64 { return p.sum() + p.sum(); }

fn recur(n: i64) -> i64 { if n < 2 { return n; } return recur(n - 1) + recur(n - 2); }

fn main() -> i64 {
    let mut p: P = P { x: 3, y: 4 };
    print_i64(p.sum());
    print_i64(wrap(&p));
    print_i64(double(side(5)));
    print_i64(double(side(1) + side(2)));
    print_i64(p.bump());
    print_i64(p.sum());
    print_i64(recur(10));
    return 0;
}
