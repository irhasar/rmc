// Assignment evaluates the value before the assignee place. The place is
// `r[{ y = 2; 0 }]`, whose index block writes `y`, so the stored value must be
// the `y` read before the place ran: `r[0]` is 1, not 2.
fn main() -> i64 {
    let mut y: i64 = 1;
    let mut a: [i64; 1] = [0; 1];
    let r: &mut [i64; 1] = &mut a;
    r[{ y = 2; 0 }] = y;
    print_i64(r[0]);
    print_i64(y);
    return 0;
}
