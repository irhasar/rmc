// `str` as a nameable type: a parameter, a return type, a struct field and a
// `let` annotation all resolve to the builtin `str` (a pointer to a
// `{len, bytes}` record), so a string can cross a call boundary and be stored
// in a struct. rustc's `&str` is the twin; rmc's `str` is one word, so a
// parameter is passed by value as its pointer.
fn classify(s: str) -> i64 {
    if s == "add" { return 1; }
    if s == "sub" { return 2; }
    if s.len() == 0 { return 3; }
    return 0;
}

fn pick(s: str) -> str {
    return s;
}

struct Msg { text: str, id: i64 }

fn msg_text(m: Msg) -> str {
    return m.text;
}

fn main() -> i64 {
    print_i64(classify("add"));
    print_i64(classify("sub"));
    print_i64(classify(""));
    print_i64(classify("nope"));
    let s: str = pick("hello");
    print_str(s);
    print_i64(s.len());
    let m = Msg { text: "world", id: 7 };
    print_str(msg_text(m));
    print_i64(m.text.len() + m.id);
    return 0;
}
