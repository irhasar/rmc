// Or-patterns `a | b | c` in a `match` arm and in `if let`, over integers,
// enums and bools. An or-pattern over every variant of an enum is exhaustive,
// so the match may stand for a value; `1 | _` is irrefutable, so its match needs
// no other arm. Each alternative is tried left to right and the arm body runs
// once when any matches.
enum Color { Red, Green, Blue }

fn classify(c: Color) -> i64 {
    return match c {
        Color::Red | Color::Green => 1,
        Color::Blue => 2,
    };
}

fn main() -> i64 {
    let x: i64 = 7;
    print_i64(match x { 1 | 3 | 7 | 9 => 10, _ => 0 });
    print_i64(match x { 0 | 1 => 5, _ => 9 });

    let c: Color = Color::Green;
    print_i64(classify(c));
    print_i64(classify(Color::Blue));

    // Every variant named across or-patterns: exhaustive, used as a value.
    let all: i64 = match c {
        Color::Red | Color::Green | Color::Blue => 42,
    };
    print_i64(all);

    let b: bool = false;
    print_i64(match b { true | false => 3 });

    // A `_` alternative makes the arm irrefutable.
    print_i64(match x { 1 | _ => 8 });

    // Negative alternatives.
    let n: i64 = -1;
    print_i64(match n { -1 | -2 => 5, _ => 0 });

    // Or-pattern in `if let`.
    if let Color::Red | Color::Green = c {
        print_i64(100);
    } else {
        print_i64(200);
    }

    return 0;
}
