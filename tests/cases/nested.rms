// Nested arrays and arrays of structs. The element stride is the element's
// size in 8-byte slots, not one: `m[i][j]` indexes an inner array of `m[i]`,
// and `a[i].field` reaches a struct at `a + i * sizeof(P)`. Every load, store,
// splat and whole-element copy must scale by that stride.
//
// rustc accepts all of this; rmc used to reject it with "array elements must
// be `i64`, `bool` or a unit enum".
struct P { x: i64, y: i64 }

fn sum_row(row: [i64; 3]) -> i64 {
    return row[0] + row[1] + row[2];
}

fn sum_pairs(a: [P; 3]) -> i64 {
    return a[0].x + a[1].y + a[2].x;
}

fn main() -> i64 {
    // A nested list literal, constant and variable indices.
    let m: [[i64; 3]; 2] = [[1, 2, 3], [4, 5, 6]];
    print_i64(m[0][0]);
    print_i64(m[0][2]);
    print_i64(m[1][0]);
    print_i64(m[1][2]);

    let mut i: i64 = 0;
    while i < 2 {
        let mut j: i64 = 0;
        while j < 3 {
            print_i64(m[i][j]);
            j = j + 1;
        }
        i = i + 1;
    }

    // A nested splat copies the inner value into every row. A large one takes
    // the counting loop path, which must copy the same source word into every
    // element instead of walking the source along with the destination.
    let z: [[i64; 3]; 2] = [[7; 3]; 2];
    print_i64(z[0][0]);
    print_i64(z[1][2]);

    let big: [[i64; 3]; 4] = [[13; 3]; 4];
    let mut bi: i64 = 0;
    while bi < 4 {
        print_i64(big[bi][0] + big[bi][1] + big[bi][2]);
        bi = bi + 1;
    }

    let sp: [P; 5] = [P { x: 4, y: 6 }; 5];
    let mut pi: i64 = 0;
    while pi < 5 {
        print_i64(sp[pi].x + sp[pi].y);
        pi = pi + 1;
    }

    // Writing through two levels of index.
    let mut w: [[i64; 2]; 2] = [[0; 2]; 2];
    w[1][0] = 11;
    w[0][1] = 22;
    print_i64(w[0][0]);
    print_i64(w[0][1]);
    print_i64(w[1][0]);
    print_i64(w[1][1]);

    // A whole inner row copied from another array.
    let src: [i64; 2] = [8, 9];
    w[0] = src;
    print_i64(w[0][0]);
    print_i64(w[0][1]);

    // An array of structs: literal, splat, field read/write, whole copy.
    let mut a: [P; 3] = [P { x: 1, y: 2 }, P { x: 3, y: 4 }, P { x: 5, y: 6 }];
    print_i64(a[0].x);
    print_i64(a[1].y);
    print_i64(a[2].x);
    a[1].x = 30;
    print_i64(a[1].x);
    let q: P = P { x: 100, y: 200 };
    a[2] = q;
    print_i64(a[2].x);
    print_i64(a[2].y);

    let s: [P; 2] = [P { x: 9, y: 8 }; 2];
    print_i64(s[0].x);
    print_i64(s[1].y);

    // Nested arrays and arrays of structs passed to functions by value.
    print_i64(sum_row(m[1]));
    print_i64(sum_pairs(a));

    // `for` over a nested array yields each inner array by value.
    let mut acc: i64 = 0;
    for row in m {
        acc = acc + row[0] + row[1] + row[2];
    }
    print_i64(acc);
    return 0;
}
