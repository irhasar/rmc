// Loops whose body is empty must still run their guard the right number of
// times, including when the guard itself has a side effect.

fn next(p: &mut i64) -> i64 {
    *p = *p + 1;
    return *p;
}

fn main() -> i64 {
    // Empty body, side-effecting guard: the guard runs until it returns 3.
    let mut i: i64 = 0;
    while next(&mut i) < 3 {
    }
    print_i64(i);

    // Empty `for` body: only the bounds and the counter step remain.
    let mut s: i64 = 0;
    for _k in 0..4 {
    }
    print_i64(s);

    // A body that only mutates the counter still tests its guard once at entry.
    let mut j: i64 = 0;
    while j < 5 {
        j = j + 1;
    }
    print_i64(j);

    // `loop` with an early exit and no other work.
    let mut n: i64 = 0;
    loop {
        n = n + 1;
        if n == 3 {
            break;
        }
    }
    print_i64(n);
    return 0;
}
