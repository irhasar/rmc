// Loops with empty bodies must still run their guard the right number of times.

fn main() -> i64 {
    let mut i: i64 = 0;
    while i < 3 {
        i = i + 1;
    }
    print_i64(i);

    let mut j: i64 = 0;
    while j < 5 {
        j = j + 1;
    }
    print_i64(j);

    let mut s: i64 = 0;
    for k in 0..4 {
        s = s + 1;
    }
    print_i64(s);

    let mut n: i64 = 0;
    loop {
        n = n + 1;
        if n == 3 {
            break;
        }
    }
    print_i64(n);
    return 0;
}
