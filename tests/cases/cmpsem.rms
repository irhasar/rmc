// Compound assignment with a side-effecting subscript evaluates the subscript
// once, and struct-literal fields initialize in source order.
struct P { x: i64, y: i64 }

fn next(c: i64) -> i64 { print_i64(c); return 1; }

fn main() -> i64 {
    let mut a: [i64; 3] = [0; 3];
    a[next(99)] += 5;
    print_i64(a[0]);
    print_i64(a[1]);
    print_i64(a[2]);

    let s: P = P { y: { print_i64(1); 2 }, x: { print_i64(2); 3 } };
    print_i64(s.x);
    print_i64(s.y);
    return 0;
}
