// LICM must not hoist a struct-field read out of a loop that writes the same
// struct through a `&mut` borrow. The loop below reads `s.b` every iteration,
// but `inc(&mut s)` changes `s.a`; the field read is not invariant and the
// total must track the mutation.
struct S {
    a: i64,
    b: i64,
}
fn inc(s: &mut S) -> i64 {
    s.a = s.a + 1;
    return s.a;
}
fn main() -> i64 {
    let mut s: S = S { a: 1, b: 2 };
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < 5 {
        t = t + inc(&mut s) + s.b;
        i = i + 1;
    }
    print_i64(t);
    print_i64(s.a);
    return 0;
}
