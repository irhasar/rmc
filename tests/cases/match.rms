// `match` on integers: each arm is an integer literal (optionally negated) or
// `_`. It desugars to a chain of `if`s, so the first equal arm runs and `_`
// matches anything. It is usable as a statement or a value, and a call in the
// scrutinee runs exactly once.
fn classify(x: i64) -> i64 {
    match x {
        0 => { return 100; }
        1 => { return 200; }
        _ => { return 300; }
    }
}

fn sign(x: i64) -> i64 {
    let s: i64 = match x {
        -1 => 11,
        0 => 22,
        1 => 33,
        _ => 44
    };
    return s;
}

fn main() -> i64 {
    print_i64(classify(0));
    print_i64(classify(1));
    print_i64(classify(5));

    // Value position, with a negative pattern.
    print_i64(sign(-1));
    print_i64(sign(0));
    print_i64(sign(1));
    print_i64(sign(9));

    // Statement position, arms are blocks, and no trailing comma is needed.
    let v: i64 = 2;
    match v {
        1 => { print_i64(1000); }
        2 => { print_i64(2000); }
        _ => { print_i64(3000); }
    }

    // Nested match and a match inside a loop.
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 9 {
        acc = acc + match i % 3 {
            0 => 100,
            1 => 10,
            _ => 1
        };
        i = i + 1;
    }
    print_i64(acc);
    return 0;
}
