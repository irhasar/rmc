// The rmc twin of `strref.rs`: rmc has no lifetime syntax of its own, so a
// `&'static str` field or `&str` parameter is written `str`, and the two are
// the same one-word value.
const N: i64 = 4;

#[derive(Copy, Clone)]
struct Msg { text: str, id: i64 }

fn text_of(m: Msg) -> str { m.text }

fn first(s: str) -> str { s }

fn main() -> i64 {
    let a: [i64; N as usize] = [10, 20, 30, 40];
    let m = Msg { text: "hello", id: 7 };
    print_str(text_of(m));
    print_str(first("world"));
    print_i64(a[0] + a[3]);
    print_i64(m.id);
    print_bool(text_of(m) == "hello");
    print_bool(text_of(m) != "hello");
    return 0;
}
