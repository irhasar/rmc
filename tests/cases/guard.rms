// `match` guards: `pat if cond => body`. The pattern test and the guard are
// folded into one condition, so a failed guard falls through to the next arm.
// A guarded arm covers *nothing* for exhaustiveness (the guard may be false),
// so a match that names every variant only through guarded arms still needs a
// `_` — here every guarded match has one.
enum Opt { None, Some(i64) }

fn sign(x: i64) -> i64 {
    // Two arms on the same binding, distinguished only by the guard.
    return match x {
        n if n > 0 => 1,
        n if n < 0 => -1,
        _ => 0,
    };
}

fn describe(o: Opt) -> i64 {
    // A guard on a payload binding: the binding is in scope in the guard.
    return match o {
        Opt::Some(v) if v > 10 => 100 + v,
        Opt::Some(v) => v,
        Opt::None => -1,
    };
}

fn main() -> i64 {
    print_i64(sign(5));
    print_i64(sign(-5));
    print_i64(sign(0));

    // A guard on a literal pattern and on an or-pattern.
    let x: i64 = 3;
    print_i64(match x { 3 if x > 1 => 10, _ => 20 });
    print_i64(match x { 1 | 2 | 3 if x == 3 => 30, _ => 40 });

    // A wildcard with a guard is not a catch-all: the arm after it still runs.
    print_i64(match x { _ if x > 10 => 1, _ => 2 });

    // A guard on a bool pattern.
    let b: bool = true;
    print_i64(match b { true if b => 7, _ => 9 });

    // Guards on payload enums, both branches.
    print_i64(describe(Opt::Some(5)));
    print_i64(describe(Opt::Some(50)));
    print_i64(describe(Opt::None));

    // The guard is evaluated only when the pattern matches, and in order.
    let mut calls: i64 = 0;
    let r: i64 = match x {
        3 if { calls = calls + 1; x > 5 } => 1,
        3 => 2,
        _ => 3,
    };
    print_i64(r);
    print_i64(calls);

    return 0;
}
