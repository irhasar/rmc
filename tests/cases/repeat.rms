// A `[v; n]` repeat literal used as a value, not just a `let` initialiser.
// It has no address of its own, so each position must materialise it: as an
// index base, a call argument, a returned array, and a struct field. Before
// this was handled these read a bare scalar as a pointer and crashed.
struct Pair { a: [i64; 3], tag: i64 }

fn sum3(v: [i64; 3]) -> i64 { return v[0] + v[1] + v[2]; }
fn make() -> [i64; 3] { return [9; 3]; }

fn main() -> i64 {
    let i: i64 = 2;
    print_i64([10; 3][i]);
    print_i64([10, 20, 30][i]);
    print_i64(sum3([4; 3]));
    let r: [i64; 3] = make();
    print_i64(r[1]);
    let p: Pair = Pair { a: [7; 3], tag: 1 };
    print_i64(p.a[2]);
    print_i64(p.tag);
    return 0;
}
