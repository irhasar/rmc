// An array-typed struct field destructured by an array sub-pattern:
// `S { a: [x, y], b }`. The expansion is a field read followed by an index
// read (`s.a[0]`, `s.a[1]`), so the two nesting directions compose: an array
// element may itself be a struct pattern, and either direction may nest.
struct I { u: i64, v: i64 }
struct S { a: [i64; 2], b: i64 }
struct T { p: [I; 2], q: i64 }

fn main() -> i64 {
    let s: S = S { a: [3, 4], b: 5 };

    // A whole array field bound element-wise.
    let S { a: [x, y], b } = s;
    print_i64(x * 100 + y * 10 + b);

    // `_` ignores an element, and a rest absorbs the middle.
    let S { a: [_, y2], .. } = s;
    print_i64(y2);
    let S { a: [p, ..], b: _ } = s;
    print_i64(p);

    // A struct pattern whose array field nests a struct element.
    let t: T = T { p: [I { u: 1, v: 2 }, I { u: 3, v: 4 }], q: 5 };
    let T { p: [I { u, v }, I { u: u2, .. }], q } = t;
    print_i64(u * 1000 + v * 100 + u2 * 10 + q);

    // Through a reference (the field read auto-derefs).
    let r: &S = &s;
    match r {
        S { a: [m, n], b } => print_i64(m * 100 + n * 10 + b),
    }

    // In a `for` head, destructuring each element's array field.
    let arr: [S; 2] = [s, S { a: [7, 8], b: 9 }];
    let mut acc: i64 = 0;
    for S { a: [m, n], .. } in arr {
        acc = acc + m * 10 + n;
    }
    print_i64(acc);

    // In an `if let`.
    if let S { a: [m, ..], .. } = s {
        print_i64(m);
    }

    // A `mut` element binding still writes.
    let S { a: [mut mm, nn], .. } = s;
    mm = mm + 100;
    print_i64(mm + nn);

    return 0;
}
