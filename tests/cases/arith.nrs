// Integer arithmetic, precedence, division and modulo.
fn main() -> i64 {
    print_i64(2 + 3 * 4);
    print_i64((2 + 3) * 4);
    print_i64(20 - 5 - 3);
    print_i64(100 / 7);
    print_i64(100 % 7);
    print_i64(-7 / 2);
    print_i64(-7 % 2);
    print_i64(7 / -2);
    print_i64(0 - 5);
    print_i64(2 * 3 * 4 * 5);
    let mut x: i64 = 17;
    x = x + 3;
    x = x * 2;
    x = x - 5;
    x = x / 3;
    print_i64(x);
    return 0;
}
