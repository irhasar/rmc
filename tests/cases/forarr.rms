// `for x in ARRAY { body }` iterates the array by value, left to right. The
// array expression is evaluated once (so a call in the head runs once), the
// loop bound is the array's compile-time length, and `continue`/`break` behave
// as in the range form. `_` discards the element.
fn mk() -> [i64; 3] {
    print_i64(-1);
    return [5, 6, 7];
}

fn main() -> i64 {
    let a: [i64; 4] = [1, 2, 3, 4];
    let mut s: i64 = 0;
    for x in a {
        s += x;
    }
    print_i64(s);

    // An array literal as the iterable.
    let mut t: i64 = 0;
    for x in [10, 20, 30] {
        t += x;
    }
    print_i64(t);

    // The head expression runs exactly once, even though it has a side effect.
    let mut u: i64 = 0;
    for x in mk() {
        u += x;
    }
    print_i64(u);

    // `continue` and `break` inside an array loop.
    let mut c: i64 = 0;
    for x in a {
        if x == 2 { continue; }
        if x == 4 { break; }
        c += x;
    }
    print_i64(c);

    // A wildcard binding counts the elements.
    let mut n: i64 = 0;
    for _ in a {
        n += 1;
    }
    print_i64(n);

    // Nested array loops, and the array is still usable afterwards.
    let b: [i64; 2] = [2, 3];
    let mut p: i64 = 0;
    for x in a {
        for y in b {
            p += x * y;
        }
    }
    print_i64(p);
    print_i64(a[1]);

    // A single-element and an empty array.
    let one: [i64; 1] = [42];
    let mut q: i64 = 0;
    for x in one {
        q += x;
    }
    print_i64(q);

    return 0;
}
