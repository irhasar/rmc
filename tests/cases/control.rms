// Control flow: while, loop, break, continue, nested loops, if/else chains,
// and blocks as expressions.
fn classify(n: i64) -> i64 {
    if n < 0 {
        return 0 - 1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}
fn main() -> i64 {
    print_i64(classify(-4));
    print_i64(classify(0));
    print_i64(classify(9));
    let mut i: i64 = 0;
    let mut s: i64 = 0;
    while i < 10 {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        s = s + i;
    }
    print_i64(s);
    let mut k: i64 = 0;
    loop {
        k = k + 1;
        if k >= 7 {
            break;
        }
    }
    print_i64(k);
    let mut total: i64 = 0;
    let mut a: i64 = 0;
    while a < 4 {
        let mut b: i64 = 0;
        while b < 4 {
            if b == 2 {
                b = b + 1;
                continue;
            }
            total = total + a * 10 + b;
            b = b + 1;
        }
        a = a + 1;
    }
    print_i64(total);
    let v: i64 = if s > 10 { 100 } else { 200 };
    print_i64(v);
    let mut w: i64 = 5;
    loop {
        if w == 0 {
            break;
        }
        w = w - 1;
    }
    print_i64(w);
    return 0;
}
