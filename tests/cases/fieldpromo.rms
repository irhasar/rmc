// Struct field promotion. A hot scalar field is kept in a register, but a
// struct that is ever copied, returned or passed by value keeps its fields in
// memory. Both paths must produce identical results.
#[derive(Clone, Copy)]
struct Vec2 { x: i64, y: i64 }
#[derive(Clone, Copy)]
struct Big { a: i64, b: i64, c: i64, d: i64 }
#[derive(Clone, Copy)]
struct Inner { p: i64, q: i64 }
#[derive(Clone, Copy)]
struct Outer { inner: Inner, z: i64 }
#[derive(Clone, Copy)]
struct WithArr { tag: i64, data: [i64; 3] }

fn addv(p: Vec2, q: Vec2) -> Vec2 {
    return Vec2 { x: p.x + q.x, y: p.y + q.y };
}

fn sum_big(b: Big) -> i64 {
    return b.a + b.b + b.c + b.d;
}

fn make(x: i64) -> Vec2 {
    return Vec2 { x: x, y: x * 2 };
}

fn main() -> i64 {
    // Hot fields in a loop: some are promoted to registers.
    let mut v: Vec2 = Vec2 { x: 1, y: 2 };
    let mut i: i64 = 0;
    while i < 5 {
        v.x = v.x + v.y;
        v.y = v.y + 1;
        i = i + 1;
    }
    print_i64(v.x);
    print_i64(v.y);

    // Whole-struct copy copies contents.
    let a: Vec2 = Vec2 { x: 10, y: 20 };
    let mut b: Vec2 = a;
    b.x = 99;
    print_i64(a.x);
    print_i64(b.x);
    print_i64(a.y);

    // Pass and return by value.
    let s: Vec2 = addv(a, b);
    print_i64(s.x);
    print_i64(s.y);
    let r: Vec2 = make(7);
    print_i64(r.x);
    print_i64(r.y);

    // Struct argument, and a field in a loop condition.
    print_i64(sum_big(Big { a: 1, b: 2, c: 3, d: 4 }));
    let mut m: Vec2 = Vec2 { x: 0, y: 3 };
    while m.x < m.y {
        m.x = m.x + 1;
    }
    print_i64(m.x);

    // Inferred literal.
    let w = Vec2 { x: 5, y: 6 };
    print_i64(w.x + w.y);

    // Nested struct field read and write.
    let mut o: Outer = Outer { inner: Inner { p: 1, q: 2 }, z: 3 };
    o.inner.p = o.inner.p + o.inner.q;
    print_i64(o.inner.p);
    print_i64(o.inner.q);
    print_i64(o.z);

    // A struct with an array field: the array stays in memory.
    let mut wa: WithArr = WithArr { tag: 4, data: [1, 2, 3] };
    wa.data[1] = wa.data[0] + wa.data[2];
    print_i64(wa.tag);
    print_i64(wa.data[0]);
    print_i64(wa.data[1]);
    print_i64(wa.data[2]);
    return 0;
}
