// A constant array length may be any constant `i64` expression. The bitwise
// operators were missing from the constant folder, so `[i64; 1 | 2]` was
// rejected as "not a non-negative constant integer".
fn main() {
    let b: [i64; 1 | 2] = [1, 2, 3];
    print_i64(b[0] + b[1] + b[2]);
    let c = [7; 4 & 6];
    print_i64(c[3]);
    let d = [9; 5 ^ 1];
    print_i64(d[3]);
    let e = [4; 1 << 3];
    print_i64(e[7]);
}
