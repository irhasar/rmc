// A struct larger than eight words exercises the loop copy in both directions,
// and mixed scalar/aggregate parameter positions exercise argument shuffling.

#[derive(Copy, Clone)]
struct Big {
    a: i64, b: i64, c: i64, d: i64, e: i64,
    f: i64, g: i64, h: i64, i: i64, j: i64,
}

fn bsum(v: Big) -> i64 {
    return v.a + v.b + v.c + v.d + v.e + v.f + v.g + v.h + v.i + v.j;
}

fn bmake(x: i64) -> Big {
    return Big {
        a: x, b: x + 1, c: x + 2, d: x + 3, e: x + 4,
        f: x + 5, g: x + 6, h: x + 7, i: x + 8, j: x + 9,
    };
}

fn mix(s: i64, v: Big, t: i64) -> i64 {
    return s * 1000 + bsum(v) + t;
}

fn main() -> i64 {
    let b: Big = bmake(100);
    print_i64(bsum(b));
    print_i64(b.a);
    print_i64(b.j);
    print_i64(mix(7, b, 9));
    print_i64(bsum(bmake(0)));
    let mut c: Big = b;
    c.a = 999;
    print_i64(c.a);
    print_i64(b.a);
    print_i64(bsum(c));
    return 0;
}
