// Loop-invariant code motion must not hoist a value that the loop's condition,
// its bounds, or an assignment target changes — including through a reference.

fn tick(x: &mut i64) -> bool {
    *x = *x + 1;
    return *x < 4;
}

fn next(x: &mut i64) -> i64 {
    *x = *x + 1;
    return 0;
}

fn main() -> i64 {
    // The `while` condition mutates `x`, so `x * x` is not invariant.
    let mut x: i64 = 0;
    let mut sum: i64 = 0;
    while tick(&mut x) {
        sum = sum + x * x;
    }
    print_i64(sum);

    // A call inside an assignment target mutates `y` through a reference.
    let mut y: i64 = 0;
    let mut a: [i64; 4] = [0, 0, 0, 0];
    let mut j: i64 = 0;
    let mut s3: i64 = 0;
    while j < 3 {
        s3 = s3 + y * y;
        a[next(&mut y)] = 0;
        j = j + 1;
    }
    print_i64(s3);
    print_i64(y);
    return 0;
}
