// Exercises alloc/free across many cycles; the count of successful
// allocations must match the Rust twin, which allocates equivalently.
fn main() -> i64 {
    let mut ok: i64 = 0;
    let mut i: i64 = 0;
    while i < 1000 {
        let p: i64 = alloc(48);
        if p != 0 {
            ok += 1;
        }
        free(p);
        i += 1;
    }
    print_i64(ok);
    return 0;
}
