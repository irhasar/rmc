// Array indexing in bounds, with and without --bounds-checks (the .bounds
// marker turns the flag on for rmc; rustc checks bounds by default). A
// spurious trap would make rmc exit 101 while rustc prints the values.
fn main() -> i64 {
    let mut a: [i64; 4] = [0; 4];
    let mut i: i64 = 0;
    while i < 4 {
        a[i] = i * i + 1;
        i = i + 1;
    }
    let mut s: i64 = 0;
    i = 0;
    while i < 4 {
        s = s + a[i];
        i = i + 1;
    }
    print_i64(s);
    print_i64(a[0]);
    print_i64(a[3]);
    let v: i64 = 2;
    print_i64(a[v]);
    return 0;
}
