struct P { a: i64, b: i64 }

impl P {
    fn sum(&self) -> i64 { return self.a + self.b; }
    fn prod(&self) -> i64 { return self.a * self.b; }
}

fn main() -> i64 {
    let n: i64 = arg_i64(1);
    // `p` is rebuilt every iteration, so its field reads are loop-variant and
    // must not be hoisted.
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let p: P = P { a: i + 1, b: i + 2 };
        acc = acc + p.sum() + p.prod();
        i = i + 1;
    }
    print_i64(acc);
    // A genuinely invariant value in a loop that also calls a function: the
    // call stops the pass, so the sum is recomputed, which is still correct.
    let q: P = P { a: 3, b: 4 };
    let mut j: i64 = 0;
    while j < n {
        print_i64(q.sum());
        j = j + 1;
    }
    // An invariant scalar expression in a loop with no call or store.
    let k: i64 = 7;
    let mut m: i64 = 0;
    let mut t: i64 = 0;
    while t < n {
        m = m + (k * k + k);
        t = t + 1;
    }
    print_i64(m);
    return 0;
}
