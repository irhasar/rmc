fn main() -> i64 {
    let mut s: i64 = 0;
    for i in 0..10 {
        if i == 3 { continue; }
        if i == 8 { break; }
        s += i;
    }
    print_i64(s);
    let mut t: i64 = 0;
    for a in 0..4 {
        for b in 0..4 {
            t += a * b;
        }
    }
    print_i64(t);
    let n: i64 = 6;
    let mut u: i64 = 0;
    for k in 0..n {
        u += k;
    }
    print_i64(u);
    return 0;
}
