fn main() -> i64 {
    let mut s: i64 = 0;
    for i in 0..10 {
        if i == 3 { continue; }
        if i == 8 { break; }
        s += i;
    }
    print_i64(s);
    let mut t: i64 = 0;
    for a in 0..4 {
        for b in 0..4 {
            t += a * b;
        }
    }
    print_i64(t);
    let n: i64 = 6;
    let mut u: i64 = 0;
    for k in 0..n {
        u += k;
    }
    print_i64(u);
    // Inclusive ranges, including an empty one (`5..=3`) and a single element.
    let mut v: i64 = 0;
    for i in 0..=10 {
        v += i;
    }
    print_i64(v);
    let mut w: i64 = 0;
    for i in 5..=3 {
        w += i;
    }
    print_i64(w);
    let mut z: i64 = 0;
    for i in 7..=7 {
        z += i;
    }
    print_i64(z);
    // Inclusive bound is evaluated once, like the exclusive one.
    let m: i64 = 4;
    let mut q: i64 = 0;
    for i in 1..=m {
        q += i;
    }
    print_i64(q);
    return 0;
}
