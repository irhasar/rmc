// Field init shorthand: `P { x, y }` means `P { x: x, y: y }`, so a field
// whose name matches a local in scope needs no `: value`. Shorthand and
// explicit fields mix freely, and the field order is not significant.
struct P { x: i64, y: i64 }

fn main() -> i64 {
    let x: i64 = 3;
    let y: i64 = 4;

    // All-shorthand.
    let p: P = P { x, y };
    print_i64(p.x);
    print_i64(p.y);

    // Mixed shorthand and explicit, in a different order than the declaration.
    let q: P = P { y: 10, x };
    print_i64(q.x);
    print_i64(q.y);

    // Shorthand of a function's own parameter names.
    let r: P = mk(x, y);
    print_i64(r.x + r.y);

    return 0;
}

fn mk(x: i64, y: i64) -> P {
    return P { x, y };
}
