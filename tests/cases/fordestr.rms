// `for S { f, g: h, .. } in arr` destructures each element. The array head is
// evaluated once into a hidden temporary, then each iteration reads the element
// into a hidden temporary and binds the named fields from it — the same shape
// as `let` destructuring, run inside the loop body.

struct P { x: i64, y: i64 }
struct Q { p: P, t: i64 }

fn mk(n: i64) -> i64 {
    print_i64(n);
    return n;
}

fn main() -> i64 {
    let arr: [P; 3] = [P { x: 1, y: 2 }, P { x: 3, y: 4 }, P { x: 5, y: 6 }];
    let mut acc: i64 = 0;

    // Shorthand bindings.
    for P { x, y } in arr { acc = acc + x * 10 + y; }

    // `..` and an ignored field.
    for P { x, .. } in arr { acc = acc + x; }
    for P { y: a, x: _ } in arr { acc = acc + a; }

    // Per-binding `mut`: the mutation is local to each iteration.
    for P { mut x, y } in arr { x = x + 100; acc = acc + x + y; }

    // A struct-typed element destructured in two steps.
    let qs: [Q; 2] = [Q { p: P { x: 7, y: 8 }, t: 1 }, Q { p: P { x: 9, y: 10 }, t: 2 }];
    for Q { p, t } in qs {
        let P { x, y } = p;
        acc = acc + x + y + t;
    }

    // The array head is evaluated once, even when it has a side effect.
    for P { x, .. } in [P { x: mk(11), y: mk(12) }, P { x: mk(13), y: mk(14) }] {
        acc = acc + x;
    }

    // `_` still runs the loop; the array head is still evaluated once.
    for _ in [P { x: mk(15), y: 0 }, P { x: mk(16), y: 0 }] { acc = acc + 1; }

    print_i64(acc);
    return 0;
}
