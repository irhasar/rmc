// Regressions from a code review. Each previously produced a wrong answer.
struct Inner { x: i64, y: i64 }
struct Outer { a: i64, inner: Inner }
struct Big { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64 }

fn make_inner(v: i64) -> Inner { return Inner { x: v, y: v + 1 }; }
fn fst(a: i64, b: i64) -> i64 { return a; }
fn next() -> i64 { return 1; }

fn main() -> i64 {
    // A whole-struct field assignment from a call must copy into the field,
    // not into whatever `%rdi` held after the call.
    let mut o: Outer = Outer { a: 1, inner: Inner { x: 0, y: 0 } };
    o.inner = make_inner(5);
    print_i64(o.a);
    print_i64(o.inner.x);
    print_i64(o.inner.y);

    // A scalar argument must survive a later argument that copies a large
    // aggregate (the copy uses `%rdi`/`%rsi`).
    let big: Big = Big { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9 };
    print_i64(fst(7, { let tmp: Big = big; 2 }));

    // A generated compound-assignment temporary must not shadow a user
    // variable whose name it resembles.
    let __rmc_ix0: i64 = 10;
    let mut a: [i64; 2] = [0; 2];
    a[next()] += __rmc_ix0;
    print_i64(a[1]);
    return 0;
}
