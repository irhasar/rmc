// `char` literals: plain, escapes, `\xNN`, `\u{..}`; `as i64`, ordering,
// equality, `match`, an array of `char`, a `const char`, and a `char`
// parameter and return value. Output must match the rustc twin.
const TAB: char = '\t';
const BIG: char = '\u{1F600}';

fn id(c: char) -> char {
    return c;
}

fn code(c: char) -> i64 {
    return c as i64;
}

fn main() {
    let a: char = 'A';
    let nl: char = '\n';
    let hex: char = '\x41';
    let tab: char = TAB;
    println!("{}", a as i64);
    println!("{}", nl as i64);
    println!("{}", hex as i64);
    println!("{}", tab as i64);
    println!("{}", BIG as i64);
    println!("{}", a);
    println!("{}", id('Z'));
    println!("{}", code('z'));
    println!("{}", a == 'A');
    println!("{}", a < 'B');
    println!("{}", 'b' > 'a');
    print_char('A');
    print_char(BIG);
    print_char('\n');
    let cs: [char; 3] = ['x', 'y', 'z'];
    let mut i: i64 = 0;
    while i < 3 {
        print!("{}", cs[i]);
        i = i + 1;
    }
    println!("");
    match a {
        'A' => println!("{}", 1),
        'B' => println!("{}", 2),
        _ => println!("{}", 3),
    }
    match cs[1] {
        'x' | 'y' => println!("{}", 10),
        _ => println!("{}", 20),
    }
    match a {
        'A'..='Z' => println!("{}", 100),
        'a'..'z' => println!("{}", 200),
        _ => println!("{}", 300),
    }
    match 'q' {
        'a'..='z' | 'A'..='Z' => println!("{}", 1),
        _ => println!("{}", 0),
    }
}
