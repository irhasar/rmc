// Aggregates (structs and arrays) passed to and returned from functions, by
// value, including struct-literal arguments and by-value copy semantics.

#[derive(Copy, Clone)]
struct Vec2 { x: i64, y: i64 }

fn add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn scale(v: Vec2, k: i64) -> Vec2 {
    return Vec2 { x: v.x * k, y: v.y * k };
}

fn sum3(a: [i64; 3]) -> i64 {
    return a[0] + a[1] + a[2];
}

fn make3(x: i64) -> [i64; 3] {
    return [x, x + 1, x + 2];
}

fn bump(mut v: Vec2) -> i64 {
    v.x += 1000;
    return v.x + v.y;
}

fn main() -> i64 {
    let a: Vec2 = Vec2 { x: 1, y: 2 };
    let b: Vec2 = Vec2 { x: 10, y: 20 };
    let c: Vec2 = add(a, b);
    print_i64(c.x);
    print_i64(c.y);
    let d: Vec2 = scale(c, 3);
    print_i64(d.x);
    print_i64(d.y);
    let e: Vec2 = add(Vec2 { x: 5, y: 5 }, Vec2 { x: -1, y: -1 });
    print_i64(e.x);
    print_i64(e.y);
    print_i64(bump(a));
    print_i64(a.x);
    let arr: [i64; 3] = [4, 5, 6];
    print_i64(sum3(arr));
    let m: [i64; 3] = make3(10);
    print_i64(m[0]);
    print_i64(m[1]);
    print_i64(m[2]);
    print_i64(sum3(make3(100)));
    return 0;
}
