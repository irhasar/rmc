[package]
name = "rakit-object"
version = "0.137.0"
authors = ["The Rakit Project Developers"]
description = "Emit Rakit output to native object files with `object`"
repository = "https://github.com/bytecodealliance/wasmtime"
documentation = "https://docs.rs/rakit-object"
license = "Apache-2.0 WITH LLVM-exception"
edition.workspace = true
rust-version.workspace = true

[lints]
workspace = true

[dependencies]
rakit-module = { workspace = true }
rakit-codegen = { workspace = true, features = ["std"] }
rakit-control = { workspace = true }
object = { workspace = true, features = ["write", "std"] }
target-lexicon = { workspace = true }
anyhow = { workspace = true }
log = { workspace = true }
gimli = { workspace = true, features = ["write"], optional = true }

[features]
default = ["unwind"]

# Enables `.eh_frame` section emission via `ObjectBuilder::unwind_info`.
unwind = ["dep:gimli", "rakit-codegen/unwind"]

[dev-dependencies]
rakit-frontend = { workspace = true }
rakit-entity = { workspace = true }
rakit-codegen = { workspace = true, features = ["x86", "arm64"] }
