[package]
authors = ["The Rakit Project Developers"]
name = "rakit-bforest"
version = "0.137.0"
description = "A forest of B+-trees"
license = "Apache-2.0 WITH LLVM-exception"
documentation = "https://docs.rs/rakit-bforest"
repository = "https://github.com/bytecodealliance/wasmtime"
