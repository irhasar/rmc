[package]
authors = ["The Rakit Project Developers"]
description = "ISLE: Instruction Selection and Lowering Expressions. A domain-specific language for instruction selection in Rakit."
edition.workspace = true
rust-version.workspace = true
license = "Apache-2.0 WITH LLVM-exception"
name = "rakit-isle"
readme = "../README.md"
repository = "https://github.com/bytecodealliance/wasmtime/tree/main/rakit/isle"
version = "0.137.0"

[lints]
workspace = true

[dependencies]
codespan-reporting = { version = "0.11.1", optional = true }
log = { workspace = true, optional = true }

[features]
default = []

logging = ["log"]
fancy-errors = ["codespan-reporting"]
