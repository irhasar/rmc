// A `for`-range workload: an exclusive range whose bound comes from argv, then
// a nested pair of inclusive ranges. The body is a loop-carried recurrence
// (`a.sum += i`, with a carry fold), so neither compiler can vectorize it and
// the measurement is loop control plus the bounds test, not a vector unit. Both
// compilers must agree exactly on the totals.
struct Acc { sum: i64, cnt: i64 }

fn main() -> i64 {
    let mut n: i64 = arg_i64(1);
    if n == 0 {
        n = 2000000;
    }
    let mut a: Acc = Acc { sum: 0, cnt: 0 };
    for i in 0..n {
        a.sum += i;
        if a.sum > 1000000000 {
            a.sum -= 1000000000;
            a.cnt += 1;
        }
    }
    for i in 0..=1000 {
        for j in 0..=10 {
            a.sum += i ^ j;
        }
    }
    print_i64(a.sum);
    print_i64(a.cnt);
    return 0;
}
