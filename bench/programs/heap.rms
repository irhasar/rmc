// Allocation- and pointer-heavy: build a singly linked list of `n` nodes on
// the heap, then walk it. Exercises `alloc`/`free` (a free-list over an mmap'd
// arena) and a raw pointer cast (`i64 as &mut Node`), which is the shape a
// hand-written data structure takes without a borrow checker.
struct Node { val: i64, next: i64 }

fn main() -> i64 {
    let n: i64 = arg_i64(1);
    if n == 0 {
        n = 200000;
    }
    let mut head: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let p: i64 = alloc(16);
        let np: &mut Node = p as &mut Node;
        (*np).val = i;
        (*np).next = head;
        head = p;
        i = i + 1;
    }
    let mut sum: i64 = 0;
    let mut cur: i64 = head;
    while cur != 0 {
        let cp: &Node = cur as &Node;
        sum = sum + (*cp).val;
        cur = (*cp).next;
    }
    print_i64(sum);
    return 0;
}
