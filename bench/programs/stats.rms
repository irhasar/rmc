// Accumulate simple statistics over a deterministic sequence, holding the
// running totals in a struct. Exercises struct field read/write in a hot loop.
struct Acc { sum: i64, count: i64, max: i64, min: i64 }

fn main() -> i64 {
    let mut n: i64 = arg_i64(1);
    if n == 0 {
        n = 2000000;
    }
    let mut a: Acc = Acc {
        sum: 0,
        count: 0,
        max: -9223372036854775807,
        min: 9223372036854775807,
    };
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = (i * 2654435761) % 1000003;
        a.sum += v;
        a.count += 1;
        if v > a.max {
            a.max = v;
        }
        if v < a.min {
            a.min = v;
        }
        i += 1;
    }
    print_i64(a.sum);
    print_i64(a.max);
    print_i64(a.min);
    print_i64(a.count);
    return 0;
}
