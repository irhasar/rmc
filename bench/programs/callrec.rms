// A call-heavy workload: non-tail recursion. Neither compiler can inline a
// recursive callee, so this measures raw call/return overhead plus the
// argument setup, which is where a stack-based code generator with no register
// allocator is weakest. rmc is expected to be *slower* here than rustc; the
// point of the program is to report that honestly rather than to win.
fn tree(n: i64) -> i64 {
    if n <= 1 {
        return n;
    }
    return 1 + tree(n - 1) + tree(n - 2);
}

fn main() -> i64 {
    let mut n: i64 = arg_i64(1);
    if n == 0 {
        n = 30;
    }
    print_i64(tree(n));
    return 0;
}
