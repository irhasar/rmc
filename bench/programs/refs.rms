// Reference-heavy: a wide struct read through `&self` methods in a hot loop.
// Without references each call would copy the 64-byte receiver; with `&self`
// the call passes one pointer.
struct Wide { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }

impl Wide {
    fn total(&self) -> i64 {
        return self.a + self.b + self.c + self.d + self.e + self.f + self.g + self.h;
    }
    fn pair(&self) -> i64 {
        return self.a * self.h + self.d * self.e;
    }
}

fn sum_via_ref(w: &Wide) -> i64 {
    return w.total() + w.pair();
}

fn main() -> i64 {
    let n: i64 = arg_i64(1);
    let w: Wide = Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
    let wr: &Wide = &w;
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        acc = acc + wr.total() + sum_via_ref(wr) + wr.pair();
        i = i + 1;
    }
    print_i64(acc);
    return 0;
}
