[package]
authors = ["The Rakit Project Developers"]
name = "rakit-frontend"
version = "0.137.0"
description = "Rakit IR builder helper"
license = "Apache-2.0 WITH LLVM-exception"
documentation = "https://docs.rs/rakit-frontend"
categories = ["no-std"]
repository = "https://github.com/bytecodealliance/wasmtime"
edition.workspace = true
rust-version.workspace = true

[lints]
workspace = true

[dependencies]
rakit-codegen = { workspace = true }
target-lexicon = { workspace = true }
log = { workspace = true }
hashbrown = { workspace = true }
smallvec = { workspace = true }

[dev-dependencies]
env_logger = { workspace = true }
similar = { workspace = true }
rakit-codegen = { workspace = true, features = ['x86'] }

[features]
default = ["std"]
std = ["rakit-codegen/std"]
core = ["rakit-codegen/core"]
