[package]
authors = ["The Rakit Project Developers"]
name = "rakit-entity"
version = "0.137.0"
description = "Data structures using entity references as mapping keys"
license = "Apache-2.0 WITH LLVM-exception"
documentation = "https://docs.rs/rakit-entity"
repository = "https://github.com/bytecodealliance/wasmtime"
categories = ["no-std"]
keywords = ["entity", "set", "map"]
edition.workspace = true
rust-version.workspace = true

[lints]
workspace = true

[dependencies]
rakit-bitset = { workspace=true }
serde = { workspace = true, optional = true }
serde_derive = { workspace = true, optional = true }
wasmtime-core = { workspace = true }

[features]
enable-serde = ["serde", "serde_derive", "rakit-bitset/enable-serde"]
