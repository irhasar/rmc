#!/bin/sh
# `rustc` with rmc as the codegen backend.
#
#   ./backend/rmc-rustc foo.rs -o foo [other rustc flags]
#
# Same CLI as rustc; the additions are `-Zcodegen-backend` and a default
# `-C opt-level=3`. rmc lowers the *optimised* MIR rustc hands it, so without
# `-O` the emitted code is much larger and slower; the backend cannot set this
# itself because opt-level drives rustc's MIR passes, which run before codegen.
# A caller's own `-C opt-level=N`/`-O` later on the line still wins (rustc takes
# the last one), so this only fills in the default. The backend dylib carries an
# rpath to the toolchain's `lib` directory (see build.sh), so no environment
# fixup is needed here and no extra `rustc` process is spawned.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
so="$here/target/release/librmc_codegen_backend.so"
if [ ! -f "$so" ]; then
    echo "rmc-rustc: $so missing; run backend/build.sh first" >&2
    exit 1
fi
exec rustc +nightly -Zcodegen-backend="$so" -C opt-level=3 "$@"
